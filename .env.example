# Copy this file to .env to override Vite dev server settings locally.
# Uncomment and adjust as needed; unset variables fall back to Vite's defaults.

# Bind the dev server to all interfaces (needed for devcontainer/Codespaces port forwarding).
# VITE_DEV_HOST=0.0.0.0

# Port for the Vite dev server (`npm run dev-server`).
# VITE_DEV_PORT=5173

# Base URL of a running `sunshine` backend to proxy /api, /images, and /covers requests to.
# VITE_BACKEND_URL=https://localhost:47990
